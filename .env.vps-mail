# VPS Mail Server Configuration
# Add these to your .env file

# Your VPS mail server details
MAIL_HOST=mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@your-domain.com
MAIL_PASSWORD=your-secure-password
MAIL_FROM_NAME=Fotonix
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_USE_TLS=false
MAIL_USE_STARTTLS=true

# Webhook security (generate a secure random string)
WEBHOOK_SECRET=your-webhook-secret-here

# Rate limiting
MAIL_RATE_LIMIT=60

# Your domain for Message-ID headers and webhook URLs
DOMAIN=fotonix.co.uk

# Database connection (if not already set)
DATABASE_URL=postgresql://username:password@localhost:5432/fotonix

# Optional: Different SMTP settings for different environments
NODE_ENV=production

# Monitoring and logging
LOG_LEVEL=info
MAIL_LOG_ENABLED=true